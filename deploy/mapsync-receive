#!/bin/sh
# /usr/local/bin/mapsync-receive — the only thing the mapsync account can run.
#
# A drawing machine (see prewarm.py --push) pipes a tar of finished map PNGs in
# over ssh. They are unpacked into a staging folder and moved into the cache
# one whole file at a time. In ~mapsync/.ssh/authorized_keys each key reads:
#   command="/usr/local/bin/mapsync-receive",restrict ssh-ed25519 AAAA... name
set -eu
CACHE=/opt/hrrr-portal/cache
d=$(mktemp -d "$CACHE/.in.XXXXXX")
trap 'rm -rf "$d"' EXIT
# A delivery can take longer than the half hour the server waits before it
# starts drawing for itself, so say "another machine is on the case" as it
# begins as well as when it ends.
touch "$CACHE/.drawn-elsewhere"
# Never an owner or mode from the sender; GNU tar already refuses absolute
# paths and ".." members. Everything is unpacked into the staging folder, and
# only the kinds of file named below are moved out of it; the rest goes with
# the folder. (Naming the kinds to tar instead makes it fail whenever a
# delivery happens to hold none of one kind.)
tar -xf - -C "$d" --no-same-owner --no-same-permissions
for f in "$d"/*.png; do
    [ -f "$f" ] || continue
    chmod 644 "$f"
    mv "$f" "$CACHE/"
done
# arrival-time grids (numpy arrays; the site loads them with pickling off)
for f in "$d"/acc_arr*.npz; do
    [ -f "$f" ] || continue
    chmod 644 "$f"
    mv "$f" "$CACHE/"
done
# the animated loop's base and label layers arrive under geo/
for f in "$d"/geo/loop_*.png; do
    [ -f "$f" ] || continue
    chmod 644 "$f"
    mv "$f" "$CACHE/geo/"
done
# tell the web server's own drawing job that another machine is on the case
touch "$CACHE/.drawn-elsewhere"
